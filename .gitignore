```gitignore
# Dependencies
node_modules/
**/node_modules/

# Environment variables and secrets
.env
.env.*
!.env.example
!**/.env.example

# Uploaded files
uploads/*
**/uploads/*
!uploads/.gitkeep
!**/uploads/.gitkeep

# Logs
*.log
npm-debug.log*

# Build files
build/
dist/
coverage/

# Local system files
.DS_Store
Thumbs.db

# Local backups
*.bak
*.backup
```
# Protect environment files everywhere
.env
.env.*
**/.env
**/.env.*